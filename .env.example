# Copy to .env and fill in. .env is gitignored -- never commit real keys.
#
# NOTE: every EXPO_PUBLIC_* variable is inlined into the shipped JS bundle and
# is readable by anyone with the app. These are prototype-grade only; for
# production, proxy Gemini through a server and keep the key server-side.

# Required. https://aistudio.google.com/
EXPO_PUBLIC_GEMINI_API_KEY=

# Required for voice coaching. https://dashboard.vapi.ai -> Settings -> API Keys
EXPO_PUBLIC_VAPI_PUBLIC_KEY=

# Optional. No backend for this ships in the repo.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Optional dev flags.
EXPO_PUBLIC_DEBUG_MODE=false
EXPO_PUBLIC_MOCK_ANALYSIS=false
